# -----------------------------------------------------------------------------
# ProcureMind Environment Configuration
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# AI provider — local Ollama through its OpenAI-compatible API
# -----------------------------------------------------------------------------
# ai-service reads these three with no defaults, so a run started from a copy of this file
# that omits them fails at startup. Pull the model first: `ollama pull hermes3:8b`.
#
# AI_BASE_URL is the host-side URL, used when ai-service runs outside Docker. Inside Docker
# Compose the base URL is overridden to http://host.docker.internal:11434 so the container
# can reach Ollama on the host; AI_API_KEY and AI_MODEL are passed through unchanged.
AI_BASE_URL=http://localhost:11434
AI_API_KEY=ollama
AI_MODEL=hermes3:8b

# -----------------------------------------------------------------------------
# Pipeline tuning (optional; defaults shown)
# -----------------------------------------------------------------------------
# Wall-clock budget for the LLM indexing loop, which runs on the Kafka consumer thread.
# Must stay well under the consumer's max.poll.interval.ms (30m) once multiplied by retries.
INDEXING_MAX_DURATION=8m
# Delay between indexing LLM calls. Zero for local Ollama; raise it for a rate-limited host.
INDEXING_INTER_CALL_DELAY=0ms

# -----------------------------------------------------------------------------
# Authorization enforcement
# -----------------------------------------------------------------------------
# Enforcing by default at the gateway, contract-service and ai-service. Setting this to
# "false" is a documented emergency kill switch, not a normal operating mode: it restores
# anonymous access while still validating any token that is presented.
AUTH_ENABLED=true

# -----------------------------------------------------------------------------
# Authentication — auth-service (Spring Authorization Server / OIDC)
# See docs/AUTH_IMPLEMENTATION_PLAN.md sections 13 & 18. Placeholders only; no real secrets.
# -----------------------------------------------------------------------------

# Static, browser-facing OIDC issuer. Advertised in the discovery document and validated as
# the `iss` claim by resource servers (wired in a later phase).
AUTH_ISSUER_URI=http://localhost:8083

# Bootstrap administrator, seeded on first start.
# Leave AUTH_ADMIN_PASSWORD blank to skip seeding the admin user.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=

# OAuth2 client redirect URIs (defaults match the local React / Streamlit dev servers).
REACT_OIDC_REDIRECT_URI=http://localhost:5173/
STREAMLIT_OIDC_REDIRECT_URI=http://localhost:8501/

# Confidential client secret for the Streamlit app (Phase 6).
# Must be set for the Streamlit login flow to work; also gates auth-service seeding of
# the procuremind-streamlit client.
STREAMLIT_OIDC_CLIENT_SECRET=

# Streamlit OIDC client (Phase 6). Browser issuer is used for the /oauth2/authorize
# redirect; internal issuer is used server-side for /oauth2/token and /userinfo.
STREAMLIT_OIDC_CLIENT_ID=procuremind-streamlit
STREAMLIT_OIDC_BROWSER_ISSUER=http://localhost:8083
STREAMLIT_OIDC_INTERNAL_ISSUER=http://auth-service:8083

# UI-side login gate for the Streamlit app. Set to "false" to run it anonymously (dev only).
AUTH_REQUIRED=true

# Persistent RSA token-signing key (optional; generate with scripts/gen-auth-keystore.sh).
# When unset, auth-service generates a NON-PERSISTENT in-memory key (dev only).
AUTH_JWK_KEYSTORE_PATH=
AUTH_JWK_KEYSTORE_PASSWORD=
AUTH_JWK_KEY_ALIAS=auth-signing
AUTH_JWK_KEY_PASSWORD=
AUTH_JWK_KEY_ID=auth-signing

# Datasource for a local (non-Docker) auth-service run. In Docker Compose the datasource is
# provided via SPRING_DATASOURCE_* pointing at the procuremind_auth database.
AUTH_DB_URL=jdbc:postgresql://localhost:5433/procuremind_auth
AUTH_DB_USERNAME=user
AUTH_DB_PASSWORD=password
