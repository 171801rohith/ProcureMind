# API gateway base URL. Leave blank to use relative URLs + the Vite dev proxy (see vite.config.js).
VITE_GATEWAY_URL=http://localhost:8080
VITE_API_TIMEOUT=120000

# -----------------------------------------------------------------------------
# OIDC login (Phase 5) — Authorization Code + PKCE against auth-service.
# -----------------------------------------------------------------------------
# Browser-facing issuer of the existing auth-service (Spring Authorization Server).
VITE_OIDC_AUTHORITY=http://localhost:8083
# Public SPA client registered in auth-service (no secret).
VITE_OIDC_CLIENT_ID=procuremind-react
VITE_OIDC_SCOPE=openid profile roles
# The silent-renew callback is served at /silent-renew.html by this app and must be
# registered with auth-service (REACT_OIDC_SILENT_REDIRECT_URI there). No refresh token is
# issued to a public client, so this is how the access token is renewed.
#
# Set to "false" to skip the login gate and run the app anonymously (dev only).
VITE_AUTH_REQUIRED=true
